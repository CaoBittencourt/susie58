    keymap {
        compatible = "zmk,keymap";

        susie {
            bindings = <
&kp ESC     &kp PT_N1  &kp PT_N2  &kp PT_N3  &kp PT_N4  &kp PT_N5                                               &kp PT_N6  &kp PT_N7      &kp PT_N8  &kp PT_N9  &kp PT_N0         &kp PT_SINGLE_QUOTE
&kp TAB     &kp Q      &kp W      &kp E      &kp R      &kp T                                                   &kp Y      &kp U          &kp I      &kp O      &kp P             &kp PT_BACKSLASH
&kp LCTRL   &kp A      &kp S      &kp D      &kp F      &kp G                                                   &kp H      &kp J          &kp K      &kp L      &kp PT_C_CEDILLA  &kp PT_TILDE
&kp LSHIFT  &kp Z      &kp X      &kp C      &kp V      &kp B      &kp PT_LEFT_BRACKET    &kp PT_RIGHT_BRACKET  &kp N      &kp M          &kp COMMA  &kp DOT    &kp PT_SEMICOLON  &kp RSHFT
                                  &kp LALT   &kp LGUI   &mo 3      &kp SPACE              &kp ENTER             &mo 1      &kp BACKSPACE  &kp RALT
            >;
        };

        nav {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                    &kp F6        &kp F7          &kp F8          &kp F9           &kp F10  &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans                    &trans        &trans          &kp UP_ARROW    &trans           &trans   &trans
&trans  &trans   &trans   &trans  &trans  &trans                    &kp PT_EQUAL  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans   &trans
&trans  &trans   &trans   &trans  &trans  &trans  &trans    &trans  &kp PT_PLUS   &kp PT_MINUS    &trans          &trans           &trans   &trans
                          &trans  &trans  &mo 2   &trans    &trans  &trans        &trans          &trans
            >;
        };

        pg {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans         &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &kp PAGE_UP    &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp HOME  &kp PAGE_DOWN  &kp END  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans         &trans   &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans
            >;
        };

        math {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &kp PT_UNDERSCORE  &kp N7   &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp EQUAL          &kp N4   &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp MINUS          &kp N1   &kp N2  &kp N3  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp PLUS           &kp N0   &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans             &kp DEL  &trans
            >;
        };

        /*
        toAssign {
            bindings = <
&kp BSLH  &kp PAGE_DOWN  &kp PAGE_UP  &kp HOME          &kp END          &kp ENTER                           &kp BACKSPACE  &kp DEL    &kp RIGHT_PARENTHESIS  &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp PIPE  &kp SEMICOLON  &kp COLON    &kp SINGLE_QUOTE  &kp K_VOLUME_UP  &kp PT_C_CEDILLA                    &kp PT_TILDE   &kp QMARK  &trans                 &trans                &trans            &trans
