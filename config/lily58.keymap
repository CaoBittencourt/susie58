#include "keys_pt_abnt2.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
        behaviors {
        inverted1: inverted1 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp PT_EXCL>, <&kp PT_N1>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        inverted2: inverted2 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp PT_AT>, <&kp PT_N2>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        inverted3: inverted3 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp PT_HASH>, <&kp PT_N3>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        inverted4: inverted4 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp PT_DLLR>, <&kp PT_N4>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        inverted5: inverted5 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp PT_PRCNT>, <&kp PT_N5>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        inverted6: inverted6 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp PT_TREMA>, <&kp PT_N6>; mods = <(MOD_LSFT|MOD_RSFT)>; }; // Handles the ABNT2 trema (¨)
        inverted7: inverted7 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp PT_AMPS>, <&kp PT_N7>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        inverted8: inverted8 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp PT_ASTRK>, <&kp PT_N8>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        inverted9: inverted9 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp PT_LPAR>, <&kp PT_N9>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        inverted0: inverted0 { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp PT_RPAR>, <&kp PT_N0>; mods = <(MOD_LSFT|MOD_RSFT)>; };
    };

    keymap {
        compatible = "zmk,keymap";

        susie {
            bindings = <
&kp ESC   &kp inverted1 &kp inverted2 &kp inverted3 &kp inverted4 &kp inverted5 &kp inverted6 &kp inverted7 &kp inverted8 &kp inverted9 &kp inverted0
&kp PT_A  &kp Q  &kp W      &kp E     &kp R         &kp T                                &kp Y          &kp U          &kp I         &kp O         &kp P          &trans
&kp TAB   &kp A  &kp S      &kp D     &kp F         &kp G                                &kp H          &kp J          &kp K         &kp L         &kp LS(PT_N1)  &trans
&kp ESC   &kp Z  &kp X      &kp C     &kp V         &kp B        &mo 3        &kp ENTER  &kp N          &kp M          &kp COMMA     &kp DOT       &trans         &trans
                            &mo 4     &kp LEFT_GUI  &kp LCTRL    &kp SPACE    &kp RSHFT  &mo 1          &kp BACKSPACE  &kp RALT
            >;
        };

        nav {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                    &kp F6  &kp F7          &kp F8          &kp F9           &kp F10  &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans                    &trans  &trans          &kp UP_ARROW    &trans           &trans   &trans
&trans  &trans   &trans   &trans  &mo 2   &trans                    &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans   &trans
&trans  &trans   &trans   &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans          &trans           &trans   &trans
                          &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans
            >;
        };

        pg {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans         &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &kp PAGE_UP    &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp HOME  &kp PAGE_DOWN  &kp END  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans         &trans   &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans
            >;
        };

        math {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans     &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans     &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp MINUS  &kp N1  &kp N2  &kp N3  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp PLUS   &kp N0  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans     &trans  &trans
            >;
        };

        toAssign {
            bindings = <
&kp BSLH  &kp PAGE_DOWN  &kp PAGE_UP  &kp HOME          &kp END          &kp ENTER                           &kp BACKSPACE  &kp DEL    &kp RIGHT_PARENTHESIS  &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp PIPE  &kp SEMICOLON  &kp COLON    &kp SINGLE_QUOTE  &kp K_VOLUME_UP  &kp PT_C_CEDILLA                    &kp PT_TILDE   &kp QMARK  &trans                 &trans                &trans            &trans
&kp A     &kp S          &kp S        &kp I             &kp G            &kp N                               &kp Y          &kp M      &kp B                  &kp O                 &kp L             &kp S
&trans    &trans         &trans       &trans            &trans           &trans            &trans    &kp S   &kp COMMA      &kp M      &kp A                  &kp T                 &kp H             &kp COMMA
                                      &trans            &trans           &trans            &trans    &trans  &kp E          &kp T      &kp C
            >;
        };
    };
};
