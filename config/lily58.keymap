#include "keys_pt_abnt2.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        dsds: dsds {
            compatible = "zmk,behavior-mod-morph";
            label = "DSDS";
            bindings = <&kp EXCL>, <&kp N1>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        susie {
            bindings = <
&kp ESC   &dsds  &kp PT_N2  &kp HASH  &kp DOLLAR    &kp PERCENT                          &kp PT_UMLAUT  &kp AMPERSAND  &kp LS(STAR)  &kp LS(LPAR)  &kp LS(RPAR)  &trans
&kp PT_A  &kp Q  &kp W      &kp E     &kp R         &kp T                                &kp Y          &kp U          &kp I         &kp O         &kp P         &trans
&kp TAB   &kp A  &kp S      &kp D     &kp F         &kp G                                &kp H          &kp J          &kp K         &kp L         &trans        &trans
&kp ESC   &kp Z  &kp X      &kp C     &kp V         &kp B        &mo 3        &trans     &kp N          &kp M          &kp COMMA     &kp DOT       &trans        &trans
                            &mo 4     &kp LEFT_GUI  &kp LCTRL    &kp SPACE    &kp RSHFT  &mo 1          &kp BACKSPACE  &kp RALT
            >;
        };

        nav {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                    &kp F6  &kp F7          &kp F8          &kp F9           &kp F10  &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans                    &trans  &trans          &kp UP_ARROW    &trans           &trans   &trans
&trans  &trans   &trans   &trans  &mo 2   &trans                    &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans   &trans
&trans  &trans   &trans   &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans          &trans           &trans   &trans
                          &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans
            >;
        };

        pg {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans         &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &kp PAGE_UP    &trans   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp HOME  &kp PAGE_DOWN  &kp END  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans         &trans   &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans
            >;
        };

        math {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans     &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans     &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &kp MINUS  &kp N1  &kp N2  &kp N3  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp PLUS   &kp N0  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans     &trans  &trans
            >;
        };

        toAssign {
            bindings = <
&kp BSLH  &kp PAGE_DOWN  &kp PAGE_UP  &kp HOME          &kp END          &kp ENTER                           &kp BACKSPACE  &kp DEL    &kp RIGHT_PARENTHESIS  &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp PIPE  &kp SEMICOLON  &kp COLON    &kp SINGLE_QUOTE  &kp K_VOLUME_UP  &kp PT_C_CEDILLA                    &kp PT_TILDE   &kp QMARK  &trans                 &trans                &trans            &trans
&kp A     &kp S          &kp S        &kp I             &kp G            &kp N                               &kp Y          &kp M      &kp B                  &kp O                 &kp L             &kp S
&trans    &trans         &trans       &trans            &trans           &trans            &trans    &kp S   &kp COMMA      &kp M      &kp A                  &kp T                 &kp H             &kp COMMA
                                      &trans            &trans           &trans            &trans    &trans  &kp E          &kp T      &kp C
            >;
        };
    };
};
